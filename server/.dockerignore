# flyctl launch added from .gitignore
# Python-generated files
**/__pycache__
**/*.py[oc]
**/build
**/dist
**/wheels
**/*.egg-info

# Virtual environments
**/.venv
**/.env

# flyctl launch added from .venv/.gitignore
.venv/**/*

# flyctl launch added from .venv/lib/python3.12/site-packages/.gitignore
# Byte-compiled / optimized / DLL files
.venv/lib/python3.12/site-packages/**/__pycache__
.venv/lib/python3.12/site-packages/**/*.py[cod]
.venv/lib/python3.12/site-packages/**/*$py.class
.venv/lib/python3.12/site-packages/**/*.so
.venv/lib/python3.12/site-packages/**/.cursor/*
# Distribution / packaging
.venv/lib/python3.12/site-packages/**/.Python
.venv/lib/python3.12/site-packages/**/build
.venv/lib/python3.12/site-packages/**/dist
